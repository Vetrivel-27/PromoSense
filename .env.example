# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=promosense_user
POSTGRES_PASSWORD=promosense_pass
POSTGRES_DB=promosense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://promosense_user:promosense_pass@localhost:5432/promosense

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=promosense_default

# FastAPI Configuration
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
